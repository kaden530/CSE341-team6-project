<%- include('../partials/header') %>


<section class="trips-hero">
    <h1>Scenic Train Trips</h1>
</section>

<div id="filters">
    Search by Region:
    <select id="region-filter">
        <option value="all">All Regions</option>
        <!-- Populated dynamically by client-side JS -->
    </select>

    Search by Season:
    <select id="season-filter">
        <option value="all">Any Season</option>
        <!-- Populated dynamically by client-side JS -->
    </select>
</div>

<div class="trips-state" id="trips-loading">Loading trips...</div>
<div class="trips-state trips-error" id="trips-error" hidden></div>


<div class="trips-grid" id="trips-list"></div>

<template id="trip-card-template">
    <article class="trip-card">
        <div class="trip-image-wrap">
            <img data-field="image" loading="lazy" decoding="async">
        </div>

        <header class="trip-card-header">
            <h2 data-field="name"></h2>
            <span class="trip-region" data-field="region"></span>
        </header>

        <dl class="trip-info">
            <div class = "station-info">
                <!--//station start-->
                <div class="station">
                    <dt class="station-type">From:</dt>
                    <dd data-field="startStation"></dd>
                </div>
                 <!--station end-->
                <div class="route-arrow">&#8594;</div>
                <div class="station">
                    <dt class="station-type">To:</dt>
                    <dd data-field= "endStation"></dd>
                </div>
            </div>
            <!--Route details-->
            <div class="route-details">
               <!--duration-->
                <div class="detail-item">
                    <span class="detail-icon">&#128337;</span>
                    <span><dt>Duration:</dt><dd data-field="duration"></dd></span>
                </div>
               <!--distance-->
                <div class="detail-item">
                    <span class="detail-icon">&#128205;</span>
                    <span><dt>Distance: </dt> <dd data-field="distance"></dd>km</span>
                </div>
                <!--best season-->
                <div class="detail-item">
                   <dt>Best Season:</dt>
                   <dd data-field="bestSeason"></dd>
                </div>
            </div>
        </dl>
        <!--route description-->
        <p class="trip-description" data-field="description"></p>
        <!--route highlights-->
        <p class="trip-highlights" data-field="highlights"></p>

        <!--route actions -->               
        <div class="route-actions">
            <a data-field="link" href="/trips/trip.id" class="view-details-btn">
                View Details &amp; Book &#8594;
            </a>
        </div>

    </article>
</template>



<%- include('../partials/footer') %>