<%- include('./partials/header') %>

<section class="bookings-admin">
    <h1>Bookings</h1>
    <div id="bookings-list"></div>

    <template id="booking-card-template">
        <article class="booking-card">
            <header>
                <h2 data-field="id"></h2>
                <time data-field="created-at"></time>
            </header>
            <dl>
                <div><dt>Trip</dt><dd data-field="trip"></dd></div>
                <div><dt>Schedule</dt><dd data-field="schedule"></dd></div>
                <div><dt>Ticket class</dt><dd data-field="ticket-class"></dd></div>
                <div><dt>Travel day</dt><dd data-field="day"></dd></div>
            </dl>
            <h3>Passengers</h3>
            <ul data-field="passengers"></ul>
        </article>
    </template>
</section>

<%- include('./partials/footer') %>
